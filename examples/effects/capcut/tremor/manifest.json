{
  "api": 1,
  "id": "io.github.tqk2811.capcut.tremor",
  "name": "Tremor",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "The first clip trembles and zooms in under a closing vignette and a lens bulge, then the second clip slams up from below with a vertical motion blur and settles with a small bounce. Recreation of the CapCut \"Tremor\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/blur-first.wgsl",
          "inputs": ["first"],
          "output": "blur_a"
        },
        {
          "shader": "shaders/blur-second.wgsl",
          "inputs": ["second"],
          "output": "blur_b"
        },
        {
          "shader": "shaders/tremor.wgsl",
          "inputs": ["blur_a", "blur_b", "first", "second"]
        }
      ]
    }
  ]
}
