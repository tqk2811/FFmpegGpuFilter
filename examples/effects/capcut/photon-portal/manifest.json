{
  "api": 1,
  "id": "io.github.tqk2811.capcut.photon-portal",
  "name": "Photon Portal",
  "version": "1.0.0",
  "description": "A violet energy ring bursts open over the shaking first clip, the second clip shows through its glowing hole and the view zooms through it. Recreation of the CapCut \"Photon Portal\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "passes": [
    {
      "shader": "shaders/scene.wgsl",
      "inputs": [
        "first",
        "second"
      ],
      "output": "scene"
    },
    {
      "shader": "shaders/glow-h.wgsl",
      "inputs": [
        "scene"
      ],
      "output": "glow_h"
    },
    {
      "shader": "shaders/glow-v.wgsl",
      "inputs": [
        "glow_h"
      ],
      "output": "glow"
    },
    {
      "shader": "shaders/finish.wgsl",
      "inputs": [
        "first",
        "second",
        "scene",
        "glow"
      ]
    }
  ]
}
