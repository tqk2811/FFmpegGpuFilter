{
  "api": 1,
  "id": "io.github.tqk2811.crossfade",
  "name": "Crossfade",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "Dissolve from the first input to the second. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/crossfade.wgsl"
        }
      ]
    }
  ]
}
