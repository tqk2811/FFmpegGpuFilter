{
  "api": 1,
  "id": "io.github.tqk2811.zoom-in-transition",
  "name": "Zoom In Transition",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "The first clip zooms into its center down to a single pixel, which then fades into the second clip. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/zoom_in_transition.wgsl"
        }
      ]
    }
  ]
}
