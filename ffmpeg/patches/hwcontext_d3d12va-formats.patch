+/*
+ * The layout of one frame in a staging buffer: one placed footprint per plane, as the
+ * device lays out a texture of this format and size. Returns the number of planes.
+ */
+static int d3d12va_get_footprints(AVHWFramesContext *ctx,
+                                  D3D12_PLACED_SUBRESOURCE_FOOTPRINT layouts[4],
+                                  UINT64 *total_size)
+{
+    AVD3D12VADeviceContext *device_hwctx = ctx->device_ctx->hwctx;
+    AVD3D12VAFramesContext *frames_hwctx = ctx->hwctx;
+    int nb_planes = av_pix_fmt_count_planes(ctx->sw_format);
+    D3D12_RESOURCE_DESC desc = {
+        .Dimension        = D3D12_RESOURCE_DIMENSION_TEXTURE2D,
+        .Alignment        = 0,
+        .Width            = ctx->width,
+        .Height           = ctx->height,
+        .DepthOrArraySize = 1,
+        .MipLevels        = 1,
+        .Format           = frames_hwctx->format,
+        .SampleDesc       = { .Count = 1, .Quality = 0 },
+        .Layout           = D3D12_TEXTURE_LAYOUT_UNKNOWN,
+        .Flags            = D3D12_RESOURCE_FLAG_NONE,
+    };
+
+    if (nb_planes < 1 || nb_planes > 4)
+        return AVERROR(EINVAL);
+
+    *total_size = 0;
+    ID3D12Device_GetCopyableFootprints(device_hwctx->device, &desc, 0, nb_planes, 0,
+                                       layouts, NULL, NULL, total_size);
+    if (!*total_size || *total_size == UINT64_MAX)
+        return AVERROR(EINVAL);
+
+    return nb_planes;
+}
