{
  "api": 1,
  "id": "io.github.tqk2811.rgba-shift",
  "name": "RGBA Shift",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "Shifts the red, green, blue and alpha channels of the picture independently (a glitch/chromatic aberration look).",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "rh",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift red horizontally, in pixels"
    },
    {
      "name": "rv",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift red vertically, in pixels"
    },
    {
      "name": "gh",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift green horizontally, in pixels"
    },
    {
      "name": "gv",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift green vertically, in pixels"
    },
    {
      "name": "bh",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift blue horizontally, in pixels"
    },
    {
      "name": "bv",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift blue vertically, in pixels"
    },
    {
      "name": "ah",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift alpha horizontally, in pixels"
    },
    {
      "name": "av",
      "type": "int",
      "default": 0,
      "min": -255,
      "max": 255,
      "description": "Shift alpha vertically, in pixels"
    },
    {
      "name": "edge",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 1,
      "description": "Edge operation: 0 = smear (repeat the edge), 1 = wrap"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/rgba_shift.wgsl"
        }
      ]
    }
  ]
}
