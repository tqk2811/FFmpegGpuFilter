{
  "api": 1,
  "id": "io.github.tqk2811.colortemperature",
  "name": "Color Temperature",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "Changes the color temperature (Kelvin) of the picture.",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "temperature",
      "type": "float",
      "default": 6500,
      "min": 1000,
      "max": 40000,
      "description": "Temperature in Kelvin"
    },
    {
      "name": "mix",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "Mix with the original"
    },
    {
      "name": "pl",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "description": "Amount of lightness preservation"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/colortemperature.wgsl"
        }
      ]
    }
  ]
}
