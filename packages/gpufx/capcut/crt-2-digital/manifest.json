{
  "api": 1,
  "id": "io.github.tqk2811.capcut.crt-2-digital",
  "name": "CRT 2 Digital",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "The camera pulls back from the first clip to an old TV in a dim room; the glitching picture falls out of the screen onto the floor, the second clip plays on the set, and the camera pushes back in. Recreation of the CapCut \"CRT 2 Digital\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/signal.wgsl",
          "inputs": [
            "first"
          ],
          "outputs": ["signal"]
        },
        {
          "shader": "shaders/smear.wgsl",
          "inputs": [
            "signal"
          ],
          "outputs": ["smeared"]
        },
        {
          "shader": "shaders/glow.wgsl",
          "inputs": [
            "smeared"
          ],
          "outputs": ["glowed"]
        },
        {
          "shader": "shaders/finish.wgsl",
          "inputs": [
            "first",
            "second",
            "glowed"
          ]
        }
      ]
    }
  ]
}
