{
  "api": 1,
  "id": "io.github.tqk2811.capcut.digital-paint",
  "name": "Digital Paint",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "The first clip flares with a pulsing glow, brush strokes paint a black-dot halftone of the second clip over it, then a second round of strokes reveals the glowing second clip, with zoom-blur punches along the way. Recreation of the CapCut \"Digital Paint\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/hl-first.wgsl",
          "inputs": ["first"],
          "outputs": ["lit_a"]
        },
        {
          "shader": "shaders/blur-h-first.wgsl",
          "inputs": ["lit_a"],
          "outputs": ["blur_a"]
        },
        {
          "shader": "shaders/blur-v-first.wgsl",
          "inputs": ["blur_a"],
          "outputs": ["glow_a"]
        },
        {
          "shader": "shaders/hl-second.wgsl",
          "inputs": ["second"],
          "outputs": ["lit_b"]
        },
        {
          "shader": "shaders/blur-h-second.wgsl",
          "inputs": ["lit_b"],
          "outputs": ["blur_b"]
        },
        {
          "shader": "shaders/blur-v-second.wgsl",
          "inputs": ["blur_b"],
          "outputs": ["glow_b"]
        },
        {
          "shader": "shaders/composite.wgsl",
          "inputs": ["first", "second", "glow_a", "glow_b"]
        }
      ]
    }
  ]
}
