{
  "api": 1,
  "id": "io.github.tqk2811.capcut.flip-fill",
  "name": "Flip Fill",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "A rounded card of the second input swings up over the first, flips over in 3D and bursts open with a vertical streak blur and a flash to fill the frame. Recreation of the CapCut \"Flip Fill\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/scene.wgsl",
          "inputs": ["first", "second"],
          "output": "lit"
        },
        {
          "shader": "shaders/streak.wgsl",
          "inputs": ["lit"],
          "output": "streak"
        },
        {
          "shader": "shaders/zoom.wgsl",
          "inputs": ["first", "second", "streak"]
        }
      ]
    }
  ]
}
