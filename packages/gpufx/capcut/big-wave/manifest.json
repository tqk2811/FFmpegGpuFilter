{
  "api": 1,
  "id": "io.github.tqk2811.capcut.big-wave",
  "name": "Big Wave",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "The first clip swells through a fisheye bulge into a turbulent zoom-blurred wave with a prism split and glow, and the second clip washes in from a pinched, rippling state. Recreation of the CapCut \"Big Wave\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/bend.wgsl",
          "inputs": [
            "first",
            "second"
          ],
          "outputs": ["bent"]
        },
        {
          "shader": "shaders/zoom.wgsl",
          "inputs": [
            "bent"
          ],
          "outputs": ["zoomed"]
        },
        {
          "shader": "shaders/wave.wgsl",
          "inputs": [
            "zoomed"
          ],
          "outputs": ["waved"]
        },
        {
          "shader": "shaders/prism.wgsl",
          "inputs": [
            "waved"
          ],
          "outputs": ["prismed"]
        },
        {
          "shader": "shaders/glow.wgsl",
          "inputs": [
            "prismed"
          ],
          "outputs": ["glow_x"]
        },
        {
          "shader": "shaders/final.wgsl",
          "inputs": [
            "prismed",
            "glow_x"
          ]
        }
      ]
    }
  ]
}
