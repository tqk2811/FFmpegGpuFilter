{
  "api": 1,
  "id": "io.github.tqk2811.capcut.tearoff-reveal",
  "name": "Tearoff Reveal",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "A perforated strip is torn down the middle of the first clip, then its two halves peel away to the sides with soft shadows, uncovering the second clip. Recreation of the CapCut \"Tearoff Reveal\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/pages.wgsl",
          "inputs": ["first"],
          "outputs": ["pages"]
        },
        {
          "shader": "shaders/blur-pages-h.wgsl",
          "inputs": ["pages"],
          "outputs": ["pages_h"]
        },
        {
          "shader": "shaders/blur-pages-v.wgsl",
          "inputs": ["pages_h"],
          "outputs": ["pages_b"]
        },
        {
          "shader": "shaders/shadows.wgsl",
          "inputs": [],
          "outputs": ["shadows"]
        },
        {
          "shader": "shaders/blur-shadows-h.wgsl",
          "inputs": ["shadows"],
          "outputs": ["shadows_h"]
        },
        {
          "shader": "shaders/blur-shadows-v.wgsl",
          "inputs": ["shadows_h"],
          "outputs": ["shadows_b"]
        },
        {
          "shader": "shaders/finish.wgsl",
          "inputs": ["first", "second", "pages_b", "shadows_b"]
        }
      ]
    }
  ]
}
