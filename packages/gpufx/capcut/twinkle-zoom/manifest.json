{
  "api": 1,
  "id": "io.github.tqk2811.capcut.twinkle-zoom",
  "name": "Twinkle Zoom",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "Dissolve to the second clip while the picture melts into a hexagonal bokeh blur whose highlights flare into sparkles, then sharpens again. Recreation of the CapCut \"Twinkle Zoom\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/blend.wgsl",
          "inputs": ["first", "second"],
          "outputs": ["blended"]
        },
        {
          "shader": "shaders/blur-v.wgsl",
          "inputs": ["blended"],
          "outputs": ["soft_v"]
        },
        {
          "shader": "shaders/blur-h.wgsl",
          "inputs": ["soft_v"],
          "outputs": ["soft"]
        },
        {
          "shader": "shaders/bokeh.wgsl",
          "inputs": ["soft"],
          "outputs": ["bokeh"]
        },
        {
          "shader": "shaders/finish.wgsl",
          "inputs": ["first", "second", "bokeh"]
        }
      ]
    }
  ]
}
