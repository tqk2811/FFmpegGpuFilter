{
  "api": 1,
  "id": "io.github.tqk2811.capcut.blu-ray-scanning",
  "name": "Blu-ray Scanning",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "A glowing blue scan line sweeps from the foreground to the background of the first clip, rippling the picture as it passes and leaving the second clip behind it. Recreation of the CapCut \"Blu-ray Scanning\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/depth.wgsl",
          "inputs": ["first"],
          "outputs": ["depth"]
        },
        {
          "shader": "shaders/glow-h.wgsl",
          "inputs": ["depth"],
          "outputs": ["glow_a"]
        },
        {
          "shader": "shaders/glow-v.wgsl",
          "inputs": ["glow_a"],
          "outputs": ["glow_b"]
        },
        {
          "shader": "shaders/glow-h2.wgsl",
          "inputs": ["glow_b"],
          "outputs": ["glow_c"]
        },
        {
          "shader": "shaders/glow-v2.wgsl",
          "inputs": ["glow_c"],
          "outputs": ["glow"]
        },
        {
          "shader": "shaders/blend.wgsl",
          "inputs": ["first", "second", "depth", "glow"],
          "outputs": ["blended"]
        },
        {
          "shader": "shaders/displace.wgsl",
          "inputs": ["blended", "depth"],
          "outputs": ["displaced"]
        },
        {
          "shader": "shaders/soften-x.wgsl",
          "inputs": ["displaced"],
          "outputs": ["soft_x"]
        },
        {
          "shader": "shaders/finish.wgsl",
          "inputs": ["first", "second", "soft_x"]
        }
      ]
    }
  ]
}
