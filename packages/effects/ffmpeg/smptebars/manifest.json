{
  "api": 1,
  "id": "io.github.tqk2811.smptebars",
  "name": "SMPTE Bars",
  "used_for": [
    "gpufx"
  ],
  "version": "1.0.0",
  "description": "SMPTE color bars (generator).",
  "inputs": [
    {
      "name": "src"
    }
  ],
  "params": [
    {
      "name": "opacity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 1,
      "description": "Blend over the input picture: 1 = only the generated picture, 0 = the input unchanged"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/smptebars.wgsl"
        }
      ]
    }
  ]
}
