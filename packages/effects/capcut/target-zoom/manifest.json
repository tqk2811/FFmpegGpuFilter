{
  "api": 1,
  "id": "io.github.tqk2811.capcut.target-zoom",
  "name": "Target Zoom",
  "used_for": ["gpufx"],
  "version": "1.0.0",
  "description": "An aiming reticle locks onto a point, the picture swirls and bulges into it, and the second clip unwinds out of the same point. Recreation of the CapCut \"Target Zoom\" transition. Drive `progress` from 0 to 1.",
  "inputs": [
    {
      "name": "first",
      "description": "Outgoing clip"
    },
    {
      "name": "second",
      "description": "Incoming clip (same size as the first)",
      "same_size": true
    }
  ],
  "params": [
    {
      "name": "progress",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "0 = first clip, 1 = second clip"
    }
  ],
  "groups": [
    {
      "passes": [
        {
          "shader": "shaders/warp.wgsl",
          "inputs": [
            "first",
            "second"
          ],
          "output": "warped"
        },
        {
          "shader": "shaders/finish.wgsl",
          "inputs": [
            "warped",
            "first",
            "second"
          ]
        }
      ]
    }
  ]
}
